# 사장님 개인용 매출 보고 — 환경변수
# 실행: cp .env.example .env && 값 채우고 → npx tsx run.ts

# ═══════════════════════════════════════════════
# 필수
# ═══════════════════════════════════════════════

# 네이버 스토어 (3개) — JSON 한 줄
NAVER_STORES_JSON='[{"name":"비타앤오리진","clientId":"17yJUlE9tefIisaNFFjgSb","clientSecret":"$2a$04$BfimJ7FAgEUxBfrz8m3fZ."},{"name":"여기명품","clientId":"6IwRzlmtQUOAybqjyBykNm","clientSecret":"$2a$04$3OXA4VRXpuEJ.vJW1MWTbe"},{"name":"와이케이팜","clientId":"4xuWEFS0YTMtTVyjcOWdaw","clientSecret":"$2a$04$S5Tvzad0kBQHz36mDPaVa."}]'

# 텔레그램 봇 — @BotFather 에서 /newbot
TELEGRAM_BOT_TOKEN=""

# 텔레그램 chat_id — @userinfobot 에서 /start
TELEGRAM_CHAT_ID=""

# ═══════════════════════════════════════════════
# 선택 — Google Sheet 자동 입력 (강력 추천)
# 비워두면 텔레그램만 발송. 채우면 raw 데이터까지 시트 누적.
# ═══════════════════════════════════════════════

# 시트 URL 의 .../d/【여기】/edit 부분
GOOGLE_SHEETS_ID=""

# Service Account 이메일 (Google Cloud → IAM → 서비스 계정)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""

# Service Account JSON 의 "private_key" 값 그대로 (\n 유지)
# 예: "-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# ═══════════════════════════════════════════════
# 선택 — 시장조사 (market.ts)
# 비워두면 시장조사 기능 안 돌아감.
# ═══════════════════════════════════════════════

# 네이버 검색광고 API (https://manage.searchad.naver.com → 내 정보 → API 사용 관리)
# market.ts keywords / market.ts size 에서 사용 — 키워드 검색량 + 연관키워드
NAVER_AD_API_KEY=""
NAVER_AD_SECRET=""
NAVER_AD_CUSTOMER_ID=""

# 네이버 Developer (https://developers.naver.com → Application 등록)
# market.ts rank 에서 사용 — 쇼핑검색 API 로 키워드별 상품 순위
NAVER_DEVELOPER_CLIENT_ID=""
NAVER_DEVELOPER_CLIENT_SECRET=""
