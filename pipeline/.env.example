# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit your real key.

# Which provider to use by default. Options: openrouter | claude | gemini
VLM_PROVIDER=openrouter

# --- OpenRouter (권장 — 한 키로 Claude/Gemini/GPT 모두 호출) -----------------
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 사용할 모델 (OpenRouter 라우팅 ID). 비워두면 openai/gpt-4o 기본.
# 추천:
#   anthropic/claude-opus-4-7   ← 가장 정확, 비쌈
#   anthropic/claude-sonnet-4-6 ← 가성비 좋음
#   openai/gpt-4o               ← 안정적
#   openai/gpt-5                ← 최신, 비쌈
#   google/gemini-2.5-pro       ← 저렴
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# 선택 — 무료 등급 통계/식별용 (OpenRouter 권장)
# OPENROUTER_REFERER=https://your-app.example.com
# OPENROUTER_APP_NAME=document-intelligence-pipeline

# --- Anthropic Claude (직접 호출) -------------------------------------------
# Get a key at: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLAUDE_MODEL=claude-opus-4-7

# --- Google Gemini (직접 호출) ----------------------------------------------
# Get a key at: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
