# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit your real key.

# Which provider to use by default. Options: claude | gemini
VLM_PROVIDER=claude

# Anthropic Claude (Vision) — required if VLM_PROVIDER=claude
# Get a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini — required only if VLM_PROVIDER=gemini
# Get a key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: override the Claude model id
# CLAUDE_MODEL=claude-opus-4-7
