generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String?
  password     String
  role         Role                 @default(SALES_REP)
  approved     Boolean              @default(false)
  phone        String?
  carrier      String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  proposals             Proposal[]
  companyRates          MemberCompanyRate[]
  documents             UserDocument[]
  filterRequests        FilterRequest[]
  userClients           UserClient[]
  prescriptionReports   PrescriptionReport[]
}

model UserClient {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName  String
  bizNumber   String
  bizDocument String?
  bizFileName String?
  approved    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  proposals             Proposal[]
  prescriptionReports   PrescriptionReport[]

  @@index([userId])
  @@unique([userId, bizNumber])
}

enum Role {
  ADMIN
  SALES_REP
  BIZ
  BASIC
  DOCTOR
  PHARMACIST
}

model MemberCompanyRate {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  additionalRate Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, companyName])
  @@index([userId])
}

model UserDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType   String
  fileName  String
  fileData  String
  createdAt DateTime @default(now())
}

model Medication {
  id             String    @id @default(cuid())
  categoryA      String?
  ingredientName String
  categoryB      String?
  commissionRate Float?
  companyName    String
  bioStatus      String?
  productName    String
  price          Int?
  originalDrug   String?
  insuranceCode  String?
  notes          String?
  isSettlement   Boolean   @default(false)
  settlementType String?   // "원외" | "원내" | null
  source         MedSource @default(EXCEL)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  proposalOriginalItems    ProposalItem[] @relation("OriginalMedication")
  proposalAlternativeItems ProposalItem[] @relation("AlternativeMedication")

  @@index([ingredientName])
  @@index([productName])
  @@index([insuranceCode])
  @@index([companyName])
}

enum MedSource {
  EXCEL
  PUBLIC_API
}

model Proposal {
  id        String         @id @default(cuid())
  title     String
  userId    String
  clientId  String?
  user      User           @relation(fields: [userId], references: [id])
  client    UserClient?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items     ProposalItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ProposalItem {
  id                   String      @id @default(cuid())
  proposalId           String
  proposal             Proposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  originalMedicationId String?
  originalMedication   Medication? @relation("OriginalMedication", fields: [originalMedicationId], references: [id])
  altMedicationId      String?
  altMedication        Medication? @relation("AlternativeMedication", fields: [altMedicationId], references: [id])
  quantity             Int         @default(1)
  note                 String?
  order                Int         @default(0)
}

model ClientCompany {
  id             String   @id @default(cuid())
  businessNumber String   @unique
  name           String
  address        String?
  representative String?
  createdAt      DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum FilterStatus {
  PENDING
  REVIEWING
  REJECTED
  APPROVED
}

model PrescriptionReport {
  id                   String      @id @default(cuid())
  userId               String
  clientId             String?
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client               UserClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  year                 Int
  month                Int
  hospitalName         String?
  companyName          String?
  imageData            String?
  ocrData              Json?
  status               String      @default("PENDING_REVIEW")
  totalFee             Float?
  clientApprovedAtSave Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([userId])
  @@index([clientId])
}

model FilterRequest {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName    String
  clientName  String
  bizNumber   String
  bizDocument String?
  bizFileName String?
  companyName String
  status      FilterStatus @default(PENDING)
  replyText   String?
  repliedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

model WholesaleSite {
  key       String              @id
  name      String
  baseUrl   String
  loginUrl  String
  active    Boolean             @default(true)
  note      String?
  snapshots InventorySnapshot[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model InventorySnapshot {
  id            String        @id @default(cuid())
  siteKey       String
  site          WholesaleSite @relation(fields: [siteKey], references: [key])
  insuranceCode String
  productName   String?
  spec          String?
  manufacturer  String?
  unitPrice     Int?
  stock         Int?
  raw           Json?
  scrapedAt     DateTime      @default(now())

  @@index([insuranceCode])
  @@index([siteKey, insuranceCode])
  @@index([scrapedAt])
}

model ScrapeJob {
  id          String    @id @default(cuid())
  siteKey     String
  mode        String
  totalCodes  Int
  doneCodes   Int       @default(0)
  failedCodes Int       @default(0)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  error       String?

  @@index([siteKey, startedAt])
}
