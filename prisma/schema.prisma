generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String?
  password     String
  role         Role                 @default(SALES_REP)
  approved     Boolean              @default(false)
  phone        String?
  carrier      String?
  salesCode    String?              @unique
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  proposals             Proposal[]
  companyRates          MemberCompanyRate[]
  documents             UserDocument[]
  filterRequests        FilterRequest[]
  userClients           UserClient[]
  prescriptionReports   PrescriptionReport[]
  loginLogs             LoginLog[]
  posts                 Post[]
  boardEditorOf         BoardEditor[]
  searchHistories       SearchHistory[]
  settlementTemplates   SettlementTemplate[]
  settlementDocuments   SettlementDocument[]
  corpRateFilesUploaded      CorpRateFile[]        @relation("CorpRateFileUploader")
  corpRateHistoriesPerformed CorpRateFileHistory[] @relation("CorpRateFileHistoryPerformer")
  processedEmails            IncomingEmail[]       @relation("EmailProcessor")
}


model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([email])
}

// 전역 공용 거래처 풀 — 모든 BIZ 회원이 공유
model Client {
  id              String   @id @default(cuid())
  clientName      String
  bizNumber       String   @unique
  code            String?  @unique
  bizDocument     String?
  bizFileKey      String?
  bizFileName     String?
  csoFileKey      String?
  csoFileName     String?
  accountFileKey  String?
  accountFileName String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientName])
  @@index([bizNumber])
}

model UserClient {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName  String
  bizNumber   String
  code        String?
  bizDocument     String?   // legacy base64 — preferred storage is Supabase Storage via bizFileKey
  bizFileKey      String?   // Supabase Storage path (bucket: client-documents) — 사업자등록증
  bizFileName     String?
  csoFileKey      String?   // CSO신고증
  csoFileName     String?
  accountFileKey  String?   // 계좌사본
  accountFileName String?
  dealerType   DealerType?
  managerName  String?
  managerPhone String?
  managerEmail String?
  memo         String?
  approved     Boolean    @default(false)
  isSettlementTarget  Boolean    @default(false)
  isRateTarget        Boolean    @default(false)
  createdAt    DateTime   @default(now())
  proposals             Proposal[]
  prescriptionReports   PrescriptionReport[]
  corpRateFiles         CorpRateFile[]

  @@index([userId])
  @@index([approved])
  @@unique([userId, bizNumber])
}

enum Role {
  ADMIN
  SALES_REP
  BIZ
  BASIC
  DOCTOR
  PHARMACIST
}

model MemberCompanyRate {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  additionalRate Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, companyName])
  @@index([userId])
}

model UserDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType   String
  fileName  String
  fileData  String?  // legacy base64 — preferred storage is Supabase Storage via fileKey
  fileKey   String?  // Supabase Storage path (bucket: user-documents)
  createdAt DateTime @default(now())
}

model Medication {
  id             String    @id @default(cuid())
  categoryA      String?
  ingredientName String
  categoryB      String?   // 식약분류 (엑셀 분류B 컬럼, 숫자)
  ingredientCode String?   // HIRA 주성분코드 (ATC 매핑 파일, 영문+숫자 예: 641400ATR)
  commissionRate Float?
  companyName    String
  bioStatus      String?
  productName    String
  price          Int?
  originalDrug   String?
  insuranceCode  String?
  notes          String?
  isSettlement   Boolean   @default(false)
  settlementType String?   // "원외" | "원내" | null
  source         MedSource @default(EXCEL)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  proposalOriginalItems    ProposalItem[] @relation("OriginalMedication")
  proposalAlternativeItems ProposalItem[] @relation("AlternativeMedication")

  @@index([ingredientName])
  @@index([productName])
  @@index([insuranceCode])
  @@index([companyName])
  @@index([ingredientCode])
  @@index([source])
  @@index([settlementType])
}

enum MedSource {
  EXCEL
  PUBLIC_API
}

model Proposal {
  id        String         @id @default(cuid())
  title     String
  userId    String
  clientId  String?
  user      User           @relation(fields: [userId], references: [id])
  client    UserClient?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items     ProposalItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ProposalItem {
  id                   String      @id @default(cuid())
  proposalId           String
  proposal             Proposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  originalMedicationId String?
  originalMedication   Medication? @relation("OriginalMedication", fields: [originalMedicationId], references: [id])
  altMedicationId      String?
  altMedication        Medication? @relation("AlternativeMedication", fields: [altMedicationId], references: [id])
  quantity             Int         @default(1)
  note                 String?
  order                Int         @default(0)
}

model ClientCompany {
  id             String   @id @default(cuid())
  businessNumber String   @unique
  name           String
  address        String?
  representative String?
  createdAt      DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum FilterStatus {
  PENDING
  REVIEWING
  REJECTED
  APPROVED
}

model PrescriptionReport {
  id                   String      @id @default(cuid())
  userId               String
  clientId             String?
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client               UserClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  year                 Int
  month                Int
  hospitalName         String?
  companyName          String?
  imageData            String?   // legacy base64 — preferred storage is Supabase Storage via imageKey
  imageKey             String?   // Supabase Storage path (bucket: prescription-images)
  ocrData              Json?
  status               String      @default("PENDING_REVIEW")
  totalFee             Float?
  clientApprovedAtSave Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([userId])
  @@index([clientId])
  @@index([status])
}

model FilterRequest {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName        String
  clientName      String
  bizNumber       String
  bizDocument     String?
  bizFileKey      String?
  bizFileName     String?
  companyName     String
  requestType     String       @default("신규")   // "신규" | "이관"
  status          FilterStatus @default(PENDING)
  replyText       String?
  repliedAt       DateTime?
  // 알림톡 자동화
  mappingId       String?
  mapping         FilterMapping? @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  responseToken   String?      @unique
  respondedAt     DateTime?
  respondedResult String?      // "가능" | "불가"
  alimtalkSentAt  DateTime?
  salesNotifiedAt DateTime?
  upperCorpName   String?      // 상위법인
  lowerCorpName   String?      // 하위법인/딜러
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([responseToken])
  @@index([status])
}

// 제약사 → 제출처(상위법인) 매핑
model FilterMapping {
  id              String    @id @default(cuid())
  clientName      String?
  companyName     String    @unique
  submissionEntity String
  managerName     String?
  managerPhone    String?
  notes           String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  requests        FilterRequest[]

  @@index([clientName])
  @@index([companyName])
}

model WholesaleSite {
  key       String              @id
  name      String
  baseUrl   String
  loginUrl  String
  active    Boolean             @default(true)
  note      String?
  snapshots InventorySnapshot[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model InventorySnapshot {
  id            String        @id @default(cuid())
  siteKey       String
  site          WholesaleSite @relation(fields: [siteKey], references: [key])
  insuranceCode String
  productName   String?
  spec          String?
  manufacturer  String?
  unitPrice     Int?
  stock         Int?
  raw           Json?
  scrapedAt     DateTime      @default(now())

  @@unique([siteKey, insuranceCode, scrapedAt])
  @@index([insuranceCode])
  @@index([siteKey, insuranceCode])
  @@index([scrapedAt])
}

model ScrapeJob {
  id          String    @id @default(cuid())
  siteKey     String
  mode        String
  totalCodes  Int
  doneCodes   Int       @default(0)
  failedCodes Int       @default(0)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  error       String?

  @@index([siteKey, startedAt])
}

model Notice {
  id          String    @id @default(cuid())
  title       String
  content     String
  category    String    @default("공지")
  isPinned    Boolean   @default(false)
  showAsPopup Boolean   @default(false)
  popupUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([showAsPopup, popupUntil])
}

model HomeBanner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  buttonText  String?
  buttonLink  String?
  imageKey    String?
  bgColor     String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

enum BoardType {
  TEXT
  IMAGE
  MIXED
}

model Board {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  type        BoardType     @default(MIXED)
  order       Int           @default(0)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  posts       Post[]
  editors     BoardEditor[]

  @@index([active, order])
}

model Post {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String?
  images    String[] @default([])
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId, createdAt])
  @@index([userId])
}

model BoardEditor {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

model CompanySubmission {
  companyName           String   @id
  submissionEntity      String?
  contactName           String?
  email                 String?
  phone                 String?
  fax                   String?
  defaultAdditionalRate Float?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SubmissionEntity {
  name        String   @id
  contactName String?
  email       String?
  phone       String?
  fax         String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  companies String[] @default([])
  resultCount Int    @default(0)
  searchedAt DateTime @default(now())

  @@index([userId, searchedAt])
}

enum DealerType {
  CORPORATION   // 법인
  INDIVIDUAL    // 개인사업자(딜러)
  UPPER_CORP    // 상위법인
  LOWER_CORP    // 하위법인
  SELF          // 자사 (와이케이)
}

model SettlementTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  corpName    String
  fileKey     String
  fileName    String
  columnMap   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents   SettlementDocument[]

  @@unique([userId, corpName])
  @@index([userId])
}

model SettlementDocument {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String?
  template   SettlementTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  corpName   String
  fileKey    String
  fileName   String
  period     String
  status     String              @default("PENDING")
  parsedData Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([userId])
  @@index([templateId])
  @@index([userId, period])
}

// 통계 제출처 관리: 거래처 × 제약사 → 제출 법인 + 이메일
model SubmissionRoute {
  id               String   @id @default(cuid())
  clientName       String
  companyName      String
  submissionEntity String
  submissionEmail  String?
  requestType      String   @default("신규")  // "신규" | "이관" — 추가수수료 적용 여부
  memo             String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  monthlyLogs      MonthlySubmissionLog[]

  @@unique([clientName, companyName])
  @@index([clientName])
  @@index([companyName])
  @@index([submissionEntity])
}

// 월별 제출 체크리스트: 매달 제출처별로 통계 제출 여부 추적
model MonthlySubmissionLog {
  id                String          @id @default(cuid())
  yearMonth         String          // "YYYY-MM"
  submissionRouteId String
  submissionRoute   SubmissionRoute @relation(fields: [submissionRouteId], references: [id], onDelete: Cascade)
  submitted         Boolean         @default(false)
  submittedAt       DateTime?
  memo              String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([yearMonth, submissionRouteId])
  @@index([yearMonth])
  @@index([submissionRouteId])
}

// 코프로모션/예외: 병원통계 제약사 → 실제 정산 제약사
model CoPromotion {
  id               String   @id @default(cuid())
  productName      String
  statCompany      String   // 병원통계에 표기되는 제약사 (예: 다산제약)
  billingCompany   String   // 실제 정산 제약사 (예: 제일약품)
  memo             String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([productName, statCompany])
  @@index([statCompany])
  @@index([billingCompany])
}

// 법인별 제약사별 추가수수료
model CorpCompanyRate {
  id             String   @id @default(cuid())
  corpName       String
  companyName    String
  additionalRate Float    @default(0)
  memo           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([corpName, companyName])
  @@index([corpName])
  @@index([companyName])
}

model CorpRateFile {
  id            String     @id @default(cuid())
  corpClientId  String
  corpClient    UserClient @relation(fields: [corpClientId], references: [id], onDelete: Cascade)
  companyName   String
  applyMonth    String     // "YYYY-MM"
  fileName      String
  fileKey       String
  uploadedById  String
  uploadedBy    User       @relation("CorpRateFileUploader", fields: [uploadedById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  history       CorpRateFileHistory[]

  @@unique([corpClientId, companyName, applyMonth])
  @@index([corpClientId])
  @@index([applyMonth])
}

model CorpRateFileHistory {
  id            String       @id @default(cuid())
  rateFileId    String
  rateFile      CorpRateFile @relation(fields: [rateFileId], references: [id], onDelete: Cascade)
  corpClientId  String       // 스냅샷
  companyName   String       // 스냅샷
  applyMonth    String       // 스냅샷
  action        String       // "UPLOAD" | "REPLACE" | "DELETE"
  prevFileKey   String?
  prevFileName  String?
  newFileKey    String?
  newFileName   String?
  performedById String
  performedBy   User         @relation("CorpRateFileHistoryPerformer", fields: [performedById], references: [id])
  createdAt     DateTime     @default(now())

  @@index([rateFileId])
  @@index([createdAt(sort: Desc)])
}

// 에이전트 활동 로그 — 팀 상태 대시보드
model AgentActivity {
  id          String    @id @default(cuid())
  agentName   String    // "biz-user-mgmt" 등
  status      String    // "idle" | "working" | "blocked" | "done"
  currentTask String?   // 현재 작업 요약
  etaAt       DateTime? // 예상 마감 (있으면)
  startedAt   DateTime?
  finishedAt  DateTime?
  notes       String?   // 추가 정보
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([agentName])
  @@index([createdAt(sort: Desc)])
}

// 텔레그램 일일 디제스트 큐 — 매일 9시 KST 발송
model BizDigestQueue {
  id              String    @id @default(cuid())
  type            String    // "completed" | "decision_needed" | "blocker" | "info"
  category        String    // "거래처/유저" | "정산" | "요율" | "필터링" | "통계제출처" | "재고크롤러" | "메타"
  title           String
  body            String    // 상세 내용 (마크다운)
  decisionOptions Json?     // 결정 필요 시 [{id, label}]
  resolvedAt      DateTime?
  resolvedBy      String?   // "사용자가 텔레그램으로 답변"
  resolvedAnswer  String?   // 사용자 답변 텍스트
  sentAt          DateTime?
  createdAt       DateTime  @default(now())

  replies         TelegramReply[] @relation("DigestReply")

  @@index([sentAt])
  @@index([type])
}

// 자동 수신된 이메일
model IncomingEmail {
  id                String   @id @default(cuid())
  messageId         String   @unique
  fromAddress       String
  fromName          String?
  subject           String
  bodyPreview       String?
  receivedAt        DateTime
  status            String   @default("PENDING")
  classifiedAs      String?
  mappedCorpId      String?
  mappedCompanyName String?
  applyMonth        String?
  processedAt       DateTime?
  processedById     String?
  processedBy       User?    @relation("EmailProcessor", fields: [processedById], references: [id])
  rateFileId        String?
  settlementDocId   String?
  errorMessage      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attachments EmailAttachment[]

  @@index([status])
  @@index([receivedAt(sort: Desc)])
  @@index([fromAddress])
}

// 이메일 첨부파일
model EmailAttachment {
  id        String        @id @default(cuid())
  emailId   String
  email     IncomingEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  size      Int
  fileKey   String
  createdAt DateTime      @default(now())

  @@index([emailId])
}

// 발신자 → 법인 매핑
model EmailSenderMapping {
  id                    String   @id @default(cuid())
  fromAddress           String   @unique
  matchType             String   @default("EXACT")
  corpClientId          String
  defaultClassification String?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([fromAddress])
  @@index([active])
}

// 텔레그램 수신 답변 저장
model TelegramReply {
  id            String          @id @default(cuid())
  messageId     String          @unique  // Telegram message_id
  chatId        String
  text          String
  digestQueueId String?
  digestQueue   BizDigestQueue? @relation("DigestReply", fields: [digestQueueId], references: [id], onDelete: SetNull)
  receivedAt    DateTime        @default(now())

  @@index([digestQueueId])
}

// =====================================================================
// ePharms 매출원장 자동수집 (yk.ep45.co.kr)
// 거래처별 ePharms 계정 1개 등록 → 매일 자정 자동 로그인 → 원장집계 스크래핑
// → KMD 포털에서 영업사원/거래처가 본인 분만 조회.
// =====================================================================

// 거래처별 ePharms 로그인 계정. PW는 AES-256-GCM 암호화하여 저장.
model EpharmsAccount {
  id              String          @id @default(cuid())
  bizNumber       String          @unique
  clientName      String
  loginId         String
  // "<ivBase64>:<authTagBase64>:<cipherBase64>"
  loginPwEnc      String
  active          Boolean         @default(true)
  lastSyncedAt    DateTime?
  lastSyncStatus  String?         // "ok" | "error"
  lastSyncError   String?
  memo            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  ledgerEntries   LedgerEntry[]
  syncLogs        LedgerSyncLog[]

  @@index([active])
}

// 매출원장 한 줄 (원장집계 화면 컬럼 그대로).
model LedgerEntry {
  id           String         @id @default(cuid())
  accountId    String
  account      EpharmsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bizNumber    String         // 빠른 필터링용 비정규화
  entryDate    DateTime       // 명세일자
  itemName     String         // 항목
  sales        Decimal        @default(0) @db.Decimal(18, 2)
  payment      Decimal        @default(0) @db.Decimal(18, 2)
  balance      Decimal        @default(0) @db.Decimal(18, 2)
  rowHash      String         // entryDate+itemName+sales+payment SHA-1
  fetchedAt    DateTime       @default(now())

  @@unique([accountId, rowHash])
  @@index([bizNumber, entryDate])
  @@index([accountId, entryDate])
}

// 동기화 시도 기록
model LedgerSyncLog {
  id           String         @id @default(cuid())
  accountId    String
  account      EpharmsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?
  status       String         // "running" | "ok" | "error"
  rowsFetched  Int            @default(0)
  rowsInserted Int            @default(0)
  errorMsg     String?

  @@index([accountId, startedAt])
  @@index([status])
}
