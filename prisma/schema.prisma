generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String?
  password     String
  role         Role                 @default(SALES_REP)
  approved     Boolean              @default(false)
  phone        String?
  carrier      String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  proposals             Proposal[]
  companyRates          MemberCompanyRate[]
  documents             UserDocument[]
  filterRequests        FilterRequest[]
  userClients           UserClient[]
  prescriptionReports   PrescriptionReport[]
  loginLogs             LoginLog[]
  posts                 Post[]
  boardEditorOf         BoardEditor[]
  searchHistories       SearchHistory[]
  settlementTemplates   SettlementTemplate[]
  settlementDocuments   SettlementDocument[]
}


model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([email])
}

model UserClient {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName  String
  bizNumber   String
  bizDocument String?   // legacy base64 — preferred storage is Supabase Storage via bizFileKey
  bizFileKey  String?   // Supabase Storage path (bucket: client-documents)
  bizFileName String?
  dealerType  DealerType?
  approved    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  proposals             Proposal[]
  prescriptionReports   PrescriptionReport[]

  @@index([userId])
  @@index([approved])
  @@unique([userId, bizNumber])
}

enum Role {
  ADMIN
  SALES_REP
  BIZ
  BASIC
  DOCTOR
  PHARMACIST
}

model MemberCompanyRate {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  additionalRate Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, companyName])
  @@index([userId])
}

model UserDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType   String
  fileName  String
  fileData  String?  // legacy base64 — preferred storage is Supabase Storage via fileKey
  fileKey   String?  // Supabase Storage path (bucket: user-documents)
  createdAt DateTime @default(now())
}

model Medication {
  id             String    @id @default(cuid())
  categoryA      String?
  ingredientName String
  categoryB      String?   // 식약분류 (엑셀 분류B 컬럼, 숫자)
  ingredientCode String?   // HIRA 주성분코드 (ATC 매핑 파일, 영문+숫자 예: 641400ATR)
  commissionRate Float?
  companyName    String
  bioStatus      String?
  productName    String
  price          Int?
  originalDrug   String?
  insuranceCode  String?
  notes          String?
  isSettlement   Boolean   @default(false)
  settlementType String?   // "원외" | "원내" | null
  source         MedSource @default(EXCEL)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  proposalOriginalItems    ProposalItem[] @relation("OriginalMedication")
  proposalAlternativeItems ProposalItem[] @relation("AlternativeMedication")

  @@index([ingredientName])
  @@index([productName])
  @@index([insuranceCode])
  @@index([companyName])
  @@index([ingredientCode])
  @@index([source])
  @@index([settlementType])
}

enum MedSource {
  EXCEL
  PUBLIC_API
}

model Proposal {
  id        String         @id @default(cuid())
  title     String
  userId    String
  clientId  String?
  user      User           @relation(fields: [userId], references: [id])
  client    UserClient?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items     ProposalItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ProposalItem {
  id                   String      @id @default(cuid())
  proposalId           String
  proposal             Proposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  originalMedicationId String?
  originalMedication   Medication? @relation("OriginalMedication", fields: [originalMedicationId], references: [id])
  altMedicationId      String?
  altMedication        Medication? @relation("AlternativeMedication", fields: [altMedicationId], references: [id])
  quantity             Int         @default(1)
  note                 String?
  order                Int         @default(0)
}

model ClientCompany {
  id             String   @id @default(cuid())
  businessNumber String   @unique
  name           String
  address        String?
  representative String?
  createdAt      DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum FilterStatus {
  PENDING
  REVIEWING
  REJECTED
  APPROVED
}

model PrescriptionReport {
  id                   String      @id @default(cuid())
  userId               String
  clientId             String?
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client               UserClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  year                 Int
  month                Int
  hospitalName         String?
  companyName          String?
  imageData            String?   // legacy base64 — preferred storage is Supabase Storage via imageKey
  imageKey             String?   // Supabase Storage path (bucket: prescription-images)
  ocrData              Json?
  status               String      @default("PENDING_REVIEW")
  totalFee             Float?
  clientApprovedAtSave Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([userId])
  @@index([clientId])
  @@index([status])
}

model FilterRequest {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName    String
  clientName  String
  bizNumber   String
  bizDocument String?   // legacy base64
  bizFileKey  String?   // Supabase Storage path (bucket: filter-request-docs)
  bizFileName String?
  companyName String
  status      FilterStatus @default(PENDING)
  replyText   String?
  repliedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

model WholesaleSite {
  key       String              @id
  name      String
  baseUrl   String
  loginUrl  String
  active    Boolean             @default(true)
  note      String?
  snapshots InventorySnapshot[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model InventorySnapshot {
  id            String        @id @default(cuid())
  siteKey       String
  site          WholesaleSite @relation(fields: [siteKey], references: [key])
  insuranceCode String
  productName   String?
  spec          String?
  manufacturer  String?
  unitPrice     Int?
  stock         Int?
  raw           Json?
  scrapedAt     DateTime      @default(now())

  @@index([insuranceCode])
  @@index([siteKey, insuranceCode])
  @@index([scrapedAt])
}

model ScrapeJob {
  id          String    @id @default(cuid())
  siteKey     String
  mode        String
  totalCodes  Int
  doneCodes   Int       @default(0)
  failedCodes Int       @default(0)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  error       String?

  @@index([siteKey, startedAt])
}

model Notice {
  id          String    @id @default(cuid())
  title       String
  content     String
  category    String    @default("공지")
  isPinned    Boolean   @default(false)
  showAsPopup Boolean   @default(false)
  popupUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([showAsPopup, popupUntil])
}

model HomeBanner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  buttonText  String?
  buttonLink  String?
  imageKey    String?
  bgColor     String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

enum BoardType {
  TEXT
  IMAGE
  MIXED
}

model Board {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  type        BoardType     @default(MIXED)
  order       Int           @default(0)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  posts       Post[]
  editors     BoardEditor[]

  @@index([active, order])
}

model Post {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String?
  images    String[] @default([])
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId, createdAt])
  @@index([userId])
}

model BoardEditor {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

model CompanySubmission {
  companyName           String   @id
  submissionEntity      String?
  contactName           String?
  email                 String?
  phone                 String?
  fax                   String?
  defaultAdditionalRate Float?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SubmissionEntity {
  name        String   @id
  contactName String?
  email       String?
  phone       String?
  fax         String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  companies String[] @default([])
  resultCount Int    @default(0)
  searchedAt DateTime @default(now())

  @@index([userId, searchedAt])
}

enum DealerType {
  CORPORATION   // 법인
  INDIVIDUAL    // 개인사업자(딜러)
  UPPER_CORP    // 상위법인
  LOWER_CORP    // 하위법인
  SELF          // 자사 (와이케이)
}

model SettlementTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  corpName    String
  fileKey     String
  fileName    String
  columnMap   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents   SettlementDocument[]

  @@unique([userId, corpName])
  @@index([userId])
}

model SettlementDocument {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String?
  template   SettlementTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  corpName   String
  fileKey    String
  fileName   String
  period     String
  status     String              @default("PENDING")
  parsedData Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([userId])
  @@index([templateId])
  @@index([userId, period])
}
