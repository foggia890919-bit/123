generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String?
  password     String
  role         Role                 @default(SALES_REP)
  approved     Boolean              @default(false)
  phone        String?
  carrier      String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  proposals             Proposal[]
  companyRates          MemberCompanyRate[]
  documents             UserDocument[]
  filterRequests        FilterRequest[]
  userClients           UserClient[]
  prescriptionReports   PrescriptionReport[]
  loginLogs             LoginLog[]
  posts                 Post[]
  boardEditorOf         BoardEditor[]
  searchHistories       SearchHistory[]
  settlementTemplates   SettlementTemplate[]
  settlementDocuments   SettlementDocument[]
}


model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([email])
}

// 전역 공용 거래처 풀 — 모든 BIZ 회원이 공유
model Client {
  id              String   @id @default(cuid())
  clientName      String
  bizNumber       String   @unique
  bizDocument     String?
  bizFileKey      String?
  bizFileName     String?
  csoFileKey      String?
  csoFileName     String?
  accountFileKey  String?
  accountFileName String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientName])
  @@index([bizNumber])
}

model UserClient {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName  String
  bizNumber   String
  bizDocument     String?   // legacy base64 — preferred storage is Supabase Storage via bizFileKey
  bizFileKey      String?   // Supabase Storage path (bucket: client-documents) — 사업자등록증
  bizFileName     String?
  csoFileKey      String?   // CSO신고증
  csoFileName     String?
  accountFileKey  String?   // 계좌사본
  accountFileName String?
  dealerType   DealerType?
  managerName  String?
  managerPhone String?
  managerEmail String?
  memo         String?
  approved     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  proposals             Proposal[]
  prescriptionReports   PrescriptionReport[]

  @@index([userId])
  @@index([approved])
  @@unique([userId, bizNumber])
}

enum Role {
  ADMIN
  SALES_REP
  BIZ
  BASIC
  DOCTOR
  PHARMACIST
}

model MemberCompanyRate {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  additionalRate Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, companyName])
  @@index([userId])
}

model UserDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType   String
  fileName  String
  fileData  String?  // legacy base64 — preferred storage is Supabase Storage via fileKey
  fileKey   String?  // Supabase Storage path (bucket: user-documents)
  createdAt DateTime @default(now())
}

model Medication {
  id             String    @id @default(cuid())
  categoryA      String?
  ingredientName String
  categoryB      String?   // 식약분류 (엑셀 분류B 컬럼, 숫자)
  ingredientCode String?   // HIRA 주성분코드 (ATC 매핑 파일, 영문+숫자 예: 641400ATR)
  commissionRate Float?
  companyName    String
  bioStatus      String?
  productName    String
  price          Int?
  originalDrug   String?
  insuranceCode  String?
  notes          String?
  isSettlement   Boolean   @default(false)
  settlementType String?   // "원외" | "원내" | null
  source         MedSource @default(EXCEL)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  proposalOriginalItems    ProposalItem[] @relation("OriginalMedication")
  proposalAlternativeItems ProposalItem[] @relation("AlternativeMedication")

  @@index([ingredientName])
  @@index([productName])
  @@index([insuranceCode])
  @@index([companyName])
  @@index([ingredientCode])
  @@index([source])
  @@index([settlementType])
}

enum MedSource {
  EXCEL
  PUBLIC_API
}

model Proposal {
  id        String         @id @default(cuid())
  title     String
  userId    String
  clientId  String?
  user      User           @relation(fields: [userId], references: [id])
  client    UserClient?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items     ProposalItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ProposalItem {
  id                   String      @id @default(cuid())
  proposalId           String
  proposal             Proposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  originalMedicationId String?
  originalMedication   Medication? @relation("OriginalMedication", fields: [originalMedicationId], references: [id])
  altMedicationId      String?
  altMedication        Medication? @relation("AlternativeMedication", fields: [altMedicationId], references: [id])
  quantity             Int         @default(1)
  note                 String?
  order                Int         @default(0)
}

model ClientCompany {
  id             String   @id @default(cuid())
  businessNumber String   @unique
  name           String
  address        String?
  representative String?
  createdAt      DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum FilterStatus {
  PENDING
  REVIEWING
  REJECTED
  APPROVED
}

model PrescriptionReport {
  id                   String      @id @default(cuid())
  userId               String
  clientId             String?
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client               UserClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  year                 Int
  month                Int
  hospitalName         String?
  companyName          String?
  imageData            String?   // legacy base64 — preferred storage is Supabase Storage via imageKey
  imageKey             String?   // Supabase Storage path (bucket: prescription-images)
  ocrData              Json?
  status               String      @default("PENDING_REVIEW")
  totalFee             Float?
  clientApprovedAtSave Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([userId])
  @@index([clientId])
  @@index([status])
}

model FilterRequest {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName        String
  clientName      String
  bizNumber       String
  bizDocument     String?
  bizFileKey      String?
  bizFileName     String?
  companyName     String
  requestType     String       @default("신규")   // "신규" | "이관"
  status          FilterStatus @default(PENDING)
  replyText       String?
  repliedAt       DateTime?
  // 알림톡 자동화
  mappingId       String?
  mapping         FilterMapping? @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  responseToken   String?      @unique
  respondedAt     DateTime?
  respondedResult String?      // "가능" | "불가"
  alimtalkSentAt  DateTime?
  salesNotifiedAt DateTime?
  upperCorpName   String?      // 상위법인
  lowerCorpName   String?      // 하위법인/딜러
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([responseToken])
  @@index([status])
}

// 거래처 × 제약사 → 제출처 매핑
model FilterMapping {
  id              String    @id @default(cuid())
  clientName      String
  companyName     String
  submissionEntity String
  managerName     String?
  managerPhone    String?
  notes           String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  requests        FilterRequest[]

  @@unique([clientName, companyName])
  @@index([clientName])
  @@index([companyName])
}

model WholesaleSite {
  key       String              @id
  name      String
  baseUrl   String
  loginUrl  String
  active    Boolean             @default(true)
  note      String?
  snapshots InventorySnapshot[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model InventorySnapshot {
  id            String        @id @default(cuid())
  siteKey       String
  site          WholesaleSite @relation(fields: [siteKey], references: [key])
  insuranceCode String
  productName   String?
  spec          String?
  manufacturer  String?
  unitPrice     Int?
  stock         Int?
  raw           Json?
  scrapedAt     DateTime      @default(now())

  @@index([insuranceCode])
  @@index([siteKey, insuranceCode])
  @@index([scrapedAt])
}

model ScrapeJob {
  id          String    @id @default(cuid())
  siteKey     String
  mode        String
  totalCodes  Int
  doneCodes   Int       @default(0)
  failedCodes Int       @default(0)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  error       String?

  @@index([siteKey, startedAt])
}

model Notice {
  id          String    @id @default(cuid())
  title       String
  content     String
  category    String    @default("공지")
  isPinned    Boolean   @default(false)
  showAsPopup Boolean   @default(false)
  popupUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([showAsPopup, popupUntil])
}

model HomeBanner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  buttonText  String?
  buttonLink  String?
  imageKey    String?
  bgColor     String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

enum BoardType {
  TEXT
  IMAGE
  MIXED
}

model Board {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  type        BoardType     @default(MIXED)
  order       Int           @default(0)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  posts       Post[]
  editors     BoardEditor[]

  @@index([active, order])
}

model Post {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String?
  images    String[] @default([])
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId, createdAt])
  @@index([userId])
}

model BoardEditor {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

model CompanySubmission {
  companyName           String   @id
  submissionEntity      String?
  contactName           String?
  email                 String?
  phone                 String?
  fax                   String?
  defaultAdditionalRate Float?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SubmissionEntity {
  name        String   @id
  contactName String?
  email       String?
  phone       String?
  fax         String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  companies String[] @default([])
  resultCount Int    @default(0)
  searchedAt DateTime @default(now())

  @@index([userId, searchedAt])
}

enum DealerType {
  CORPORATION   // 법인
  INDIVIDUAL    // 개인사업자(딜러)
  UPPER_CORP    // 상위법인
  LOWER_CORP    // 하위법인
  SELF          // 자사 (와이케이)
}

model SettlementTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  corpName    String
  fileKey     String
  fileName    String
  columnMap   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents   SettlementDocument[]

  @@unique([userId, corpName])
  @@index([userId])
}

model SettlementDocument {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String?
  template   SettlementTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  corpName   String
  fileKey    String
  fileName   String
  period     String
  status     String              @default("PENDING")
  parsedData Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([userId])
  @@index([templateId])
  @@index([userId, period])
}

// ─── Real estate (병의원 개원 매물 탐색) ──────────────────────────────────
// 개인 사용 목적 도구. 네이버부동산은 약관상 자동수집을 금지하므로 보수적 간격
// (RE_SCRAPE_INTERVAL_MS, 기본 3000ms)으로만 동작하며, 수집한 중개사 연락처는
// 동의 없는 광고/마케팅 발송에 사용해서는 안 된다 (개인정보보호법·정보통신망법).

model REAgent {
  id             String   @id @default(cuid())
  externalId     String   @unique // 네이버 realtorId or cpId
  name           String
  phone          String?
  address        String?
  representative String?
  registrationNo String?
  source         String   @default("naver")
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  listings       REListing[]

  @@index([name])
  @@index([phone])
}

model REListing {
  id            String    @id @default(cuid())
  externalId    String    @unique // 네이버 articleNo
  source        String    @default("naver")
  url           String?
  tradeType     String    // 매매 | 전세 | 월세
  propertyType  String    // 상가 | 사무실 | 빌딩 | 토지 | 아파트 | 기타
  title         String?
  cortarNo      String?   // 행정동 코드
  address       String?
  region        String?
  latitude      Float?
  longitude     Float?
  priceSale     Int?      // 매매가 (만원)
  priceDeposit  Int?      // 보증금
  priceMonthly  Int?      // 월세
  areaSupply    Float?    // 공급 ㎡
  areaExclusive Float?    // 전용 ㎡
  floor         String?
  description   String?
  features      String[]  @default([])
  raw           Json?
  agentId       String?
  agent         REAgent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)
  postedAt      DateTime?
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  closedAt      DateTime?
  alerts        REAlert[]

  @@index([cortarNo])
  @@index([propertyType])
  @@index([tradeType])
  @@index([firstSeenAt])
  @@index([priceSale])
  @@index([priceDeposit])
}

model REWatch {
  id              String   @id @default(cuid())
  ownerEmail      String
  name            String
  enabled         Boolean  @default(true)
  cortarNos       String[] @default([])
  propertyTypes   String[] @default([])
  tradeTypes      String[] @default([])
  priceSaleMax    Int?
  priceDepositMax Int?
  priceMonthlyMax Int?
  areaMinM2       Float?
  areaMaxM2       Float?
  floorMin        Int?
  floorMax        Int?
  keywords        String[] @default([])
  excludeKeywords String[] @default([])
  notifySms       Boolean  @default(false)
  notifyTelegram  Boolean  @default(false)
  smsTo           String?
  telegramChatId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  alerts          REAlert[]

  @@index([ownerEmail])
  @@index([enabled])
}

model REAlert {
  id        String    @id @default(cuid())
  watchId   String
  watch     REWatch   @relation(fields: [watchId], references: [id], onDelete: Cascade)
  listingId String
  listing   REListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  channel   String    // sms | telegram | log
  status    String    @default("PENDING")
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([watchId, listingId])
  @@index([status])
  @@index([createdAt])
}

model MolitTrade {
  id            String   @id @default(cuid())
  dealKind      String   // 상업업무용 | 오피스텔 | 아파트 등
  tradeType     String   // 매매 | 전월세
  region        String
  lawdCd        String
  dealYearMonth String   // YYYYMM
  dealDay       Int?
  buildingName  String?
  areaM2        Float?
  floor         String?
  buildYear     Int?
  amount        Int?     // 만원
  deposit       Int?
  monthlyRent   Int?
  raw           Json?
  fetchedAt     DateTime @default(now())

  @@index([lawdCd, dealYearMonth])
  @@index([dealKind])
}

// 한국부동산원 상업용부동산 임대동향조사 — 분기별 권역 평균.
// 매매가 × 투자수익률 = 추정 연임대료 환산에 사용.
model RoneStat {
  id              String   @id @default(cuid())
  // "오피스" | "중대형상가" | "소규모상가" | "집합상가"
  buildingType    String
  region          String   // 시군구명 또는 상권명 (예: "강남구", "강남대로")
  regionCode      String?  // R-ONE 내부 코드 (있으면)
  yearQuarter     String   // YYYYQn (예: 2025Q1)
  rentPerM2       Float?   // 월 임대료 (원/㎡)
  vacancyRate     Float?   // 공실률 (%)
  yieldRate       Float?   // 투자수익률 (%, 연간)
  capRate         Float?   // 소득수익률 (%, 연간) — cap rate 본체
  raw             Json?
  fetchedAt       DateTime @default(now())

  @@unique([buildingType, region, yearQuarter])
  @@index([region])
  @@index([yearQuarter])
}

// 소상공인 상권정보 — 후보지의 업종 분포·유동인구·임대시세 추정치.
model SbizMarketArea {
  id            String   @id @default(cuid())
  trarNo        String   @unique // 상권 고유번호
  trarName      String
  cortarNo      String?
  sido          String?
  sigungu       String?
  // 통계 스냅샷 (가장 최신값)
  storeCount    Int?     // 점포 수
  medicalClinic Int?     // 의료기관 수 (의·치·한 + 약국)
  populationDay Int?     // 주간 유동인구
  populationNight Int?
  estimatedRentPerM2 Float? // 추정 월 임대료 (원/㎡)
  raw           Json?
  fetchedAt     DateTime @default(now())

  @@index([cortarNo])
  @@index([sigungu])
}
