generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String?
  password     String
  role         Role                 @default(SALES_REP)
  approved     Boolean              @default(false)
  phone        String?
  carrier      String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  proposals             Proposal[]
  companyRates          MemberCompanyRate[]
  documents             UserDocument[]
  filterRequests        FilterRequest[]
  userClients           UserClient[]
  prescriptionReports   PrescriptionReport[]
  loginLogs             LoginLog[]
  posts                 Post[]
  boardEditorOf         BoardEditor[]
  searchHistories       SearchHistory[]
  settlementTemplates   SettlementTemplate[]
  settlementDocuments   SettlementDocument[]
}


model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([email])
}

// 전역 공용 거래처 풀 — 모든 BIZ 회원이 공유
model Client {
  id              String   @id @default(cuid())
  clientName      String
  bizNumber       String   @unique
  bizDocument     String?
  bizFileKey      String?
  bizFileName     String?
  csoFileKey      String?
  csoFileName     String?
  accountFileKey  String?
  accountFileName String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientName])
  @@index([bizNumber])
}

model UserClient {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName  String
  bizNumber   String
  bizDocument     String?   // legacy base64 — preferred storage is Supabase Storage via bizFileKey
  bizFileKey      String?   // Supabase Storage path (bucket: client-documents) — 사업자등록증
  bizFileName     String?
  csoFileKey      String?   // CSO신고증
  csoFileName     String?
  accountFileKey  String?   // 계좌사본
  accountFileName String?
  dealerType   DealerType?
  managerName  String?
  managerPhone String?
  managerEmail String?
  memo         String?
  approved     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  proposals             Proposal[]
  prescriptionReports   PrescriptionReport[]

  @@index([userId])
  @@index([approved])
  @@unique([userId, bizNumber])
}

enum Role {
  ADMIN
  SALES_REP
  BIZ
  BASIC
  DOCTOR
  PHARMACIST
}

model MemberCompanyRate {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  additionalRate Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, companyName])
  @@index([userId])
}

model UserDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType   String
  fileName  String
  fileData  String?  // legacy base64 — preferred storage is Supabase Storage via fileKey
  fileKey   String?  // Supabase Storage path (bucket: user-documents)
  createdAt DateTime @default(now())
}

model Medication {
  id             String    @id @default(cuid())
  categoryA      String?
  ingredientName String
  categoryB      String?   // 식약분류 (엑셀 분류B 컬럼, 숫자)
  ingredientCode String?   // HIRA 주성분코드 (ATC 매핑 파일, 영문+숫자 예: 641400ATR)
  commissionRate Float?
  companyName    String
  bioStatus      String?
  productName    String
  price          Int?
  originalDrug   String?
  insuranceCode  String?
  notes          String?
  isSettlement   Boolean   @default(false)
  settlementType String?   // "원외" | "원내" | null
  source         MedSource @default(EXCEL)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  proposalOriginalItems    ProposalItem[] @relation("OriginalMedication")
  proposalAlternativeItems ProposalItem[] @relation("AlternativeMedication")

  @@index([ingredientName])
  @@index([productName])
  @@index([insuranceCode])
  @@index([companyName])
  @@index([ingredientCode])
  @@index([source])
  @@index([settlementType])
}

enum MedSource {
  EXCEL
  PUBLIC_API
}

model Proposal {
  id        String         @id @default(cuid())
  title     String
  userId    String
  clientId  String?
  user      User           @relation(fields: [userId], references: [id])
  client    UserClient?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items     ProposalItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ProposalItem {
  id                   String      @id @default(cuid())
  proposalId           String
  proposal             Proposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  originalMedicationId String?
  originalMedication   Medication? @relation("OriginalMedication", fields: [originalMedicationId], references: [id])
  altMedicationId      String?
  altMedication        Medication? @relation("AlternativeMedication", fields: [altMedicationId], references: [id])
  quantity             Int         @default(1)
  note                 String?
  order                Int         @default(0)
}

model ClientCompany {
  id             String   @id @default(cuid())
  businessNumber String   @unique
  name           String
  address        String?
  representative String?
  createdAt      DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum FilterStatus {
  PENDING
  REVIEWING
  REJECTED
  APPROVED
}

model PrescriptionReport {
  id                   String      @id @default(cuid())
  userId               String
  clientId             String?
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client               UserClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  year                 Int
  month                Int
  hospitalName         String?
  companyName          String?
  imageData            String?   // legacy base64 — preferred storage is Supabase Storage via imageKey
  imageKey             String?   // Supabase Storage path (bucket: prescription-images)
  ocrData              Json?
  status               String      @default("PENDING_REVIEW")
  totalFee             Float?
  clientApprovedAtSave Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([userId])
  @@index([clientId])
  @@index([status])
}

model FilterRequest {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName        String
  clientName      String
  bizNumber       String
  bizDocument     String?
  bizFileKey      String?
  bizFileName     String?
  companyName     String
  requestType     String       @default("신규")   // "신규" | "이관"
  status          FilterStatus @default(PENDING)
  replyText       String?
  repliedAt       DateTime?
  // 알림톡 자동화
  mappingId       String?
  mapping         FilterMapping? @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  responseToken   String?      @unique
  respondedAt     DateTime?
  respondedResult String?      // "가능" | "불가"
  alimtalkSentAt  DateTime?
  salesNotifiedAt DateTime?
  upperCorpName   String?      // 상위법인
  lowerCorpName   String?      // 하위법인/딜러
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([responseToken])
  @@index([status])
}

// 거래처 × 제약사 → 제출처 매핑
model FilterMapping {
  id              String    @id @default(cuid())
  clientName      String
  companyName     String
  submissionEntity String
  managerName     String?
  managerPhone    String?
  notes           String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  requests        FilterRequest[]

  @@unique([clientName, companyName])
  @@index([clientName])
  @@index([companyName])
}

model WholesaleSite {
  key       String              @id
  name      String
  baseUrl   String
  loginUrl  String
  active    Boolean             @default(true)
  note      String?
  snapshots InventorySnapshot[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model InventorySnapshot {
  id            String        @id @default(cuid())
  siteKey       String
  site          WholesaleSite @relation(fields: [siteKey], references: [key])
  insuranceCode String
  productName   String?
  spec          String?
  manufacturer  String?
  unitPrice     Int?
  stock         Int?
  raw           Json?
  scrapedAt     DateTime      @default(now())

  @@index([insuranceCode])
  @@index([siteKey, insuranceCode])
  @@index([scrapedAt])
}

model ScrapeJob {
  id          String    @id @default(cuid())
  siteKey     String
  mode        String
  totalCodes  Int
  doneCodes   Int       @default(0)
  failedCodes Int       @default(0)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  error       String?

  @@index([siteKey, startedAt])
}

model Notice {
  id          String    @id @default(cuid())
  title       String
  content     String
  category    String    @default("공지")
  isPinned    Boolean   @default(false)
  showAsPopup Boolean   @default(false)
  popupUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([showAsPopup, popupUntil])
}

model HomeBanner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  buttonText  String?
  buttonLink  String?
  imageKey    String?
  bgColor     String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

enum BoardType {
  TEXT
  IMAGE
  MIXED
}

model Board {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  type        BoardType     @default(MIXED)
  order       Int           @default(0)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  posts       Post[]
  editors     BoardEditor[]

  @@index([active, order])
}

model Post {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String?
  images    String[] @default([])
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId, createdAt])
  @@index([userId])
}

model BoardEditor {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

model CompanySubmission {
  companyName           String   @id
  submissionEntity      String?
  contactName           String?
  email                 String?
  phone                 String?
  fax                   String?
  defaultAdditionalRate Float?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SubmissionEntity {
  name        String   @id
  contactName String?
  email       String?
  phone       String?
  fax         String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  companies String[] @default([])
  resultCount Int    @default(0)
  searchedAt DateTime @default(now())

  @@index([userId, searchedAt])
}

enum DealerType {
  CORPORATION   // 법인
  INDIVIDUAL    // 개인사업자(딜러)
  UPPER_CORP    // 상위법인
  LOWER_CORP    // 하위법인
  SELF          // 자사 (와이케이)
}

model SettlementTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  corpName    String
  fileKey     String
  fileName    String
  columnMap   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents   SettlementDocument[]

  @@unique([userId, corpName])
  @@index([userId])
}

model SettlementDocument {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String?
  template   SettlementTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  corpName   String
  fileKey    String
  fileName   String
  period     String
  status     String              @default("PENDING")
  parsedData Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([userId])
  @@index([templateId])
  @@index([userId, period])
}

// ─── Real estate (병의원 개원 매물 탐색) ──────────────────────────────────
// 개인 사용 목적 도구. 네이버부동산은 약관상 자동수집을 금지하므로 보수적 간격
// (RE_SCRAPE_INTERVAL_MS, 기본 3000ms)으로만 동작하며, 수집한 중개사 연락처는
// 동의 없는 광고/마케팅 발송에 사용해서는 안 된다 (개인정보보호법·정보통신망법).

model REAgent {
  id             String   @id @default(cuid())
  externalId     String   @unique // 네이버 realtorId or cpId
  name           String
  phone          String?
  address        String?
  representative String?
  registrationNo String?
  source         String   @default("naver")
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  listings       REListing[]

  @@index([name])
  @@index([phone])
}

model REListing {
  id            String    @id @default(cuid())
  externalId    String    @unique // 네이버 articleNo
  source        String    @default("naver")
  url           String?
  tradeType     String    // 매매 | 전세 | 월세
  propertyType  String    // 상가 | 사무실 | 빌딩 | 토지 | 아파트 | 기타
  title         String?
  cortarNo      String?   // 행정동 코드
  address       String?
  region        String?
  latitude      Float?
  longitude     Float?
  priceSale     Int?      // 매매가 (만원)
  priceDeposit  Int?      // 보증금
  priceMonthly  Int?      // 월세
  areaSupply    Float?    // 공급 ㎡
  areaExclusive Float?    // 전용 ㎡
  floor         String?
  description   String?
  features      String[]  @default([])
  raw           Json?
  agentId       String?
  agent         REAgent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)
  postedAt      DateTime?
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  closedAt      DateTime?
  alerts        REAlert[]

  @@index([cortarNo])
  @@index([propertyType])
  @@index([tradeType])
  @@index([firstSeenAt])
  @@index([priceSale])
  @@index([priceDeposit])
}

model REWatch {
  id              String   @id @default(cuid())
  ownerEmail      String
  name            String
  enabled         Boolean  @default(true)
  cortarNos       String[] @default([])
  propertyTypes   String[] @default([])
  tradeTypes      String[] @default([])
  priceSaleMax    Int?
  priceDepositMax Int?
  priceMonthlyMax Int?
  areaMinM2       Float?
  areaMaxM2       Float?
  floorMin        Int?
  floorMax        Int?
  keywords        String[] @default([])
  excludeKeywords String[] @default([])
  notifySms       Boolean  @default(false)
  notifyTelegram  Boolean  @default(false)
  smsTo           String?
  telegramChatId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  alerts          REAlert[]

  @@index([ownerEmail])
  @@index([enabled])
}

model REAlert {
  id        String    @id @default(cuid())
  watchId   String
  watch     REWatch   @relation(fields: [watchId], references: [id], onDelete: Cascade)
  listingId String
  listing   REListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  channel   String    // sms | telegram | log
  status    String    @default("PENDING")
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([watchId, listingId])
  @@index([status])
  @@index([createdAt])
}

model MolitTrade {
  id            String   @id @default(cuid())
  dealKind      String   // 상업업무용 | 오피스텔 | 아파트 등
  tradeType     String   // 매매 | 전월세
  region        String
  lawdCd        String
  dealYearMonth String   // YYYYMM
  dealDay       Int?
  buildingName  String?
  areaM2        Float?
  floor         String?
  buildYear     Int?
  amount        Int?     // 만원
  deposit       Int?
  monthlyRent   Int?
  raw           Json?
  fetchedAt     DateTime @default(now())

  @@index([lawdCd, dealYearMonth])
  @@index([dealKind])
}

// 한국부동산원 상업용부동산 임대동향조사 — 분기별 권역 평균.
// 매매가 × 투자수익률 = 추정 연임대료 환산에 사용.
model RoneStat {
  id              String   @id @default(cuid())
  // "오피스" | "중대형상가" | "소규모상가" | "집합상가"
  buildingType    String
  region          String   // 시군구명 또는 상권명 (예: "강남구", "강남대로")
  regionCode      String?  // R-ONE 내부 코드 (있으면)
  yearQuarter     String   // YYYYQn (예: 2025Q1)
  rentPerM2       Float?   // 월 임대료 (원/㎡)
  vacancyRate     Float?   // 공실률 (%)
  yieldRate       Float?   // 투자수익률 (%, 연간)
  capRate         Float?   // 소득수익률 (%, 연간) — cap rate 본체
  raw             Json?
  fetchedAt       DateTime @default(now())

  @@unique([buildingType, region, yearQuarter])
  @@index([region])
  @@index([yearQuarter])
}

// 소상공인 상권정보 — 후보지의 업종 분포·유동인구·임대시세 추정치.
model SbizMarketArea {
  id            String   @id @default(cuid())
  trarNo        String   @unique // 상권 고유번호
  trarName      String
  cortarNo      String?
  sido          String?
  sigungu       String?
  // 통계 스냅샷 (가장 최신값)
  storeCount    Int?     // 점포 수
  medicalClinic Int?     // 의료기관 수 (의·치·한 + 약국)
  populationDay Int?     // 주간 유동인구
  populationNight Int?
  estimatedRentPerM2 Float? // 추정 월 임대료 (원/㎡)
  raw           Json?
  fetchedAt     DateTime @default(now())

  @@index([cortarNo])
  @@index([sigungu])
}

// ─── Phase 3: 토지·건축 ──────────────────────────────────────────────
// 지번 → 필지(Parcel) → 기존 건물(BuildingLedger) → 매싱 결과(MassingResult).

model Parcel {
  id             String   @id @default(cuid())
  pnu            String   @unique // 19자리 필지고유번호
  jibun          String?
  cortarNo       String?
  sigungu        String?
  area           Float?   // ㎡
  landUse        String?  // 용도지역
  landUseDistrict String? // 용도지구
  landUseExtra   String?  // 용도구역 (있는 경우)
  bcrLimit       Float?   // 법정 건폐율 % (룩업 결과)
  farLimit       Float?   // 법정 용적률 % (룩업 결과)
  officialPrice  Int?     // 개별공시지가 원/㎡
  centerLat      Float?
  centerLng      Float?
  geometry       Json?    // GeoJSON Polygon
  raw            Json?
  fetchedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ledgers        BuildingLedger[]
  massings       MassingResult[]

  @@index([cortarNo])
  @@index([sigungu])
  @@index([landUse])
}

model BuildingLedger {
  id                String   @id @default(cuid())
  pnu               String
  parcelId          String?
  parcel            Parcel?  @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  bldgNm            String?
  totalFloorArea    Float?   // 연면적 ㎡
  buildArea         Float?   // 건축면적 ㎡
  bcr               Float?   // 실제 건폐율 %
  far               Float?   // 실제 용적률 %
  groundFloors      Int?
  undergroundFloors Int?
  mainPurpose       String?  // 주용도
  structure         String?
  approvedAt        DateTime?
  raw               Json?
  fetchedAt         DateTime @default(now())

  @@index([pnu])
  @@index([parcelId])
}

model MassingResult {
  id                       String   @id @default(cuid())
  parcelId                 String
  parcel                   Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  scenario                 String   // "medical-default" 등
  buildingType             String
  floorHeight              Float
  efficiency               Float
  parkingRule              String
  bcrApplied               Float
  farApplied               Float
  maxBuildArea             Float
  maxFloorArea             Float
  maxFloors                Int
  parkingRequired          Int
  basementFloors           Int
  netRentableArea          Float
  estimatedConstructionCost Int     // 만원
  notes                    String[] @default([])
  // Phase 2 valuation과 결합된 결과를 캐시 (옵션)
  estimatedAnnualRent      Int?     // 만원
  estimatedRoi             Float?   // %
  createdAt                DateTime @default(now())

  @@index([parcelId])
  @@index([scenario])
}

// ─── Phase 4: 분양·입주 예정지 + 인구통계 ─────────────────────────────
// 청약홈/LH/공공데이터포털에서 수집. proximity matcher가 인접 후보 필지를 자동 매칭.

model ApartmentNotice {
  id              String   @id @default(cuid())
  externalId      String   @unique // 청약홈 공고번호 또는 LH 공고일련번호
  source          String   // "applyhome" | "lh" | "manual"
  noticeName      String
  houseType       String?  // 아파트/오피스텔/도시형생활주택 등
  totalHouseholds Int?
  generalHouseholds Int?
  specialHouseholds Int?
  // 위치
  region          String?  // 시도/시군구/동
  cortarNo        String?  // 행정동 10자리
  address         String?
  latitude        Float?
  longitude       Float?
  // 일정
  noticeAt        DateTime?  // 공고일
  applyStartAt    DateTime?  // 청약 시작
  applyEndAt      DateTime?
  contractAt      DateTime?
  moveInAt        DateTime?  // 입주 예정월 (1일로 정규화)
  // 가격
  priceMin        Int?       // 분양가 최저(만원)
  priceMax        Int?
  // 평형
  areaMin         Float?     // ㎡
  areaMax         Float?
  raw             Json?
  fetchedAt       DateTime   @default(now())
  // 매칭 결과 캐시 (proximity)
  matches         NoticeParcelMatch[]

  @@index([source])
  @@index([cortarNo])
  @@index([moveInAt])
  @@index([latitude, longitude])
}

model NoticeParcelMatch {
  id          String   @id @default(cuid())
  noticeId    String
  notice      ApartmentNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  parcelId    String?
  listingId   String?
  // 거리 (m)
  distanceM   Float
  // 방향 (단지 정문 → 매물). 향후 보행 동선 분석에 활용.
  bearing     Float?
  matchType   String   // "parcel" | "listing"
  createdAt   DateTime @default(now())

  @@index([noticeId])
  @@index([parcelId])
  @@index([listingId])
  @@index([distanceM])
}

model Census {
  id          String   @id @default(cuid())
  cortarNo    String   // 10자리 행정동
  yearMonth   String   // YYYYMM
  totalPop    Int?
  households  Int?
  // 연령대
  age0_9      Int?
  age10_19    Int?
  age20_29    Int?
  age30_39    Int?
  age40_49    Int?
  age50_59    Int?
  age60_69    Int?
  age70Plus   Int?
  // 성별
  malePop     Int?
  femalePop   Int?
  raw         Json?
  fetchedAt   DateTime @default(now())

  @@unique([cortarNo, yearMonth])
  @@index([cortarNo])
  @@index([yearMonth])
}

// ─── Phase 5: 의료기관 + 처방 통계 ────────────────────────────────────
// 심평원(HIRA) 병의원정보서비스 + 보건의료빅데이터 통계.

model MedicalFacility {
  id              String   @id @default(cuid())
  ykiho           String   @unique // HIRA 의료기관 식별자 (암호화)
  name            String
  // 분류
  facilityType    String?  // 종합병원/병원/의원/치과/한의원/약국
  specialties     String[] @default([]) // 진료과목 (내과,소아과,정형외과 등)
  // 규모
  bedCount        Int?
  doctorCount     Int?
  equipment       String[] @default([]) // CT, MRI, 초음파 등
  // 위치
  address         String?
  cortarNo        String?
  sigungu         String?
  latitude        Float?
  longitude       Float?
  // 운영 상태
  openedAt        DateTime?
  closedAt        DateTime?
  status          String   @default("OPEN") // OPEN | CLOSED | RELOCATED
  raw             Json?
  fetchedAt       DateTime @default(now())

  @@index([cortarNo])
  @@index([sigungu])
  @@index([facilityType])
  @@index([status])
  @@index([latitude, longitude])
}

model PrescriptionStat {
  id              String   @id @default(cuid())
  cortarNo        String   // 행정동 (또는 시군구 lawdCd)
  yearMonth       String   // YYYYMM
  scope           String   // "dong" | "sigungu"
  // 진료과목별 (있으면)
  specialty       String?  // 내과/소아과/정형외과 등
  // 측정값
  patientCount    Int?     // 진료받은 환자 수
  visitCount      Int?     // 내원 일수
  prescriptionCount Int?   // 처방전 발급 건수
  totalAmount     Int?     // 총 진료비 (천원 단위)
  raw             Json?
  fetchedAt       DateTime @default(now())

  @@unique([cortarNo, yearMonth, scope, specialty])
  @@index([cortarNo, yearMonth])
  @@index([specialty])
}

// 입지 종합 점수 — Phase 6에서 가중치 모델로 갱신.
model LocationScore {
  id                  String   @id @default(cuid())
  parcelId            String   @unique
  computedAt          DateTime @default(now())
  // 입력 메트릭
  backingHouseholds   Int?     // 반경 1km 내 분양 예정 세대수 합
  competitorClinics   Int?     // 반경 500m 내 경쟁 의원 수
  populationDensity   Float?   // 행정동 인구밀도
  prescriptionDemand  Float?   // 처방수요 추정값
  supplyAdvantage     Float?   // 자체 약국 공급 매출(만원/월) 향후 회귀
  buildableRoi        Float?   // Phase 2/3 ROI
  trafficFlow         Float?   // 지하철/버스 (Phase 6)
  pIndex              Float?   // 비급여 지불지수 (Phase 6, 유료)
  // 가중치 적용 결과
  prescriptionScore   Float?
  compositeScore      Float?
  recommendedSpecialties String[] @default([])
  notes               String[] @default([])

  @@index([compositeScore])
}
