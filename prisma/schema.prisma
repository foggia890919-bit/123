generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String?
  password     String
  role         Role                 @default(SALES_REP)
  approved     Boolean              @default(false)
  phone        String?
  carrier      String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  proposals      Proposal[]
  companyRates   MemberCompanyRate[]
  documents      UserDocument[]
  filterRequests FilterRequest[]
  ownedWorkspaces      Workspace[]       @relation("OwnedWorkspaces")
  workspaceMemberships WorkspaceMember[]
}

enum Role {
  ADMIN
  SALES_REP
  DOCTOR
  PHARMACIST
}

model MemberCompanyRate {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  additionalRate Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, companyName])
  @@index([userId])
}

model UserDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType   String
  fileName  String
  fileData  String
  createdAt DateTime @default(now())
}

model Medication {
  id             String    @id @default(cuid())
  categoryA      String?
  ingredientName String
  categoryB      String?
  commissionRate Float?
  companyName    String
  bioStatus      String?
  productName    String
  price          Int?
  originalDrug   String?
  insuranceCode  String?
  notes          String?
  isSettlement   Boolean   @default(false)
  settlementType String?   // "원외" | "원내" | null
  source         MedSource @default(EXCEL)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  proposalOriginalItems    ProposalItem[] @relation("OriginalMedication")
  proposalAlternativeItems ProposalItem[] @relation("AlternativeMedication")

  @@index([ingredientName])
  @@index([productName])
  @@index([insuranceCode])
  @@index([companyName])
}

enum MedSource {
  EXCEL
  PUBLIC_API
}

model Proposal {
  id        String         @id @default(cuid())
  title     String
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  items     ProposalItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ProposalItem {
  id                   String      @id @default(cuid())
  proposalId           String
  proposal             Proposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  originalMedicationId String?
  originalMedication   Medication? @relation("OriginalMedication", fields: [originalMedicationId], references: [id])
  altMedicationId      String?
  altMedication        Medication? @relation("AlternativeMedication", fields: [altMedicationId], references: [id])
  quantity             Int         @default(1)
  note                 String?
  order                Int         @default(0)
}

model ClientCompany {
  id             String   @id @default(cuid())
  businessNumber String   @unique
  name           String
  address        String?
  representative String?
  createdAt      DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum FilterStatus {
  PENDING
  REVIEWING
  REJECTED
  APPROVED
}

model FilterRequest {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName    String
  clientName  String
  bizNumber   String
  bizDocument String?
  bizFileName String?
  companyName String
  status      FilterStatus @default(PENDING)
  replyText   String?
  repliedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

// ──────────────────────────────────────────────
// 네이버 매출 자동화 — 멀티테넌시
// ──────────────────────────────────────────────

model Workspace {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  ownerId       String
  owner         User              @relation("OwnedWorkspaces", fields: [ownerId], references: [id])
  // 채널 연동 (워크스페이스 단위 오버라이드, 비워두면 글로벌 .env 사용)
  telegramBotToken          String?
  telegramChatId            String?
  googleSheetsId            String?
  googleServiceAccountEmail String?
  googleServiceAccountKey   String?
  // 보고 시각 (KST HH:mm)
  reportTime    String            @default("09:00")
  enabled       Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  members       WorkspaceMember[]
  stores        NaverStore[]
  reports       DailyReportLog[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model NaverStore {
  id           String         @id @default(cuid())
  workspaceId  String
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code         String
  bizName      String
  storeName    String
  clientId     String
  clientSecret String
  enabled      Boolean        @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  products     NaverProduct[]
  orders       NaverOrder[]
  backfillJobs BackfillJob[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
}

model NaverProduct {
  id               String           @id @default(cuid())
  storeId          String
  store            NaverStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  channelProductNo String
  productName      String
  // 사장님이 보고 대상으로 켠 상품만 보고에 포함
  watched          Boolean          @default(true)
  // 마지막으로 네이버 상품 API 에서 정보 가져온 시각
  lastImportedAt   DateTime?
  // 첫 발견 시 텔레그램 신상품 알림 보낸 여부
  notifiedNew      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  costs            ProductCost[]
  items            NaverOrderItem[]

  @@unique([storeId, channelProductNo])
  @@index([storeId])
  @@index([watched])
}

model ProductCost {
  id             String       @id @default(cuid())
  productId      String
  product        NaverProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionName     String       @default("")
  keyword        String       @default("")
  bottlesPerUnit Int          @default(1)
  unitCost       Int          @default(0)
  shippingCost   Int          @default(0)
  fulfillCost    Int          @default(0)
  packagingCost  Int          @default(0)
  etcCost        Int          @default(0)
  effectiveAt    DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([productId, optionName, effectiveAt])
  @@index([productId])
  @@index([keyword])
}

model NaverOrder {
  id          String           @id @default(cuid())
  storeId     String
  store       NaverStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId     String
  paymentDate DateTime
  buyerName   String?
  totalAmount Int              @default(0)
  status      String?
  raw         Json?
  createdAt   DateTime         @default(now())
  items       NaverOrderItem[]

  @@unique([storeId, orderId])
  @@index([storeId, paymentDate])
}

model NaverOrderItem {
  id                 String        @id @default(cuid())
  orderId            String
  order              NaverOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String?
  product            NaverProduct? @relation(fields: [productId], references: [id])
  productOrderId     String        @unique
  channelProductNo   String?
  sellerProductCode  String?
  productName        String
  optionName         String        @default("")
  quantity           Int           @default(1)
  unitPrice          Int           @default(0)
  optionPrice        Int           @default(0)
  discountAmount     Int           @default(0)
  salesAmount        Int           @default(0)
  channelCommission  Int           @default(0)
  payCommission      Int           @default(0)
  settlementAmount   Int           @default(0)
  deliveryFee        Int           @default(0)
  paymentMethod      String?
  channelName        String?
  status             String?
  detailStatus       String?
  paymentDate        DateTime
  orderedAt          DateTime?

  @@index([orderId])
  @@index([productId])
  @@index([paymentDate])
}

model DailyReportLog {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reportDate  DateTime
  sentAt      DateTime @default(now())
  channel     String
  ok          Boolean
  message     String?

  @@unique([workspaceId, reportDate])
  @@index([workspaceId])
}

model BackfillJob {
  id          String       @id @default(cuid())
  workspaceId String
  storeId     String
  store       NaverStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fromDate    DateTime
  toDate      DateTime
  // 다음에 처리할 날짜 (KST 자정). 처음엔 fromDate, 진행되면서 앞으로 이동.
  cursor      DateTime
  status      String       @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  ordersAdded Int          @default(0)
  itemsAdded  Int          @default(0)
  errors      Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workspaceId])
  @@index([storeId])
  @@index([status])
}
