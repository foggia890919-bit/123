# ── 모바일 앱 (Expo) ─────────────────────────────────────────────
# EXPO_PUBLIC_ 접두사 변수만 앱 번들에 포함됩니다.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── 서버 시크릿 (앱에 넣지 말 것!) ────────────────────────────────
# Edge Function에서만 사용하며, 아래 명령으로 Supabase에 등록합니다:
#   supabase secrets set DEEPGRAM_API_KEY=... ANTHROPIC_API_KEY=...
#
# DEEPGRAM_API_KEY=your-deepgram-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
#
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY 는 Edge Function 런타임에
# 자동 주입되므로 별도 설정이 필요 없습니다.
