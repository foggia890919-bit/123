# Inventory scraper configuration
# Copy to .env and fill in real values. Do NOT commit .env.

# ---- Vercel runtime (real-time stock check API) ----
# Set both on Vercel project settings, NOT here. The worker URL is the
# public address of your Lightsail server.
# WORKER_URL=http://13.124.xxx.xxx:8080
# WORKER_TOKEN=<same token as worker/.env>

# ---- Local PoC scraper (only used by scripts/win/scrape-poc.bat) ----

# Comma-separated adapter keys to run (must exist in src/scrapers/adapters/index.ts)
SCRAPER_SITES=ibjp

# Per-site rate limit between requests (ms). 2000ms = safe default.
SCRAPE_INTERVAL_MS=2000

# Distribution strategy: round-robin | cross
#   round-robin: each code hits one site (fast, load-split across sites)
#   cross:       each code hits every site (slow, enables cross-site price compare)
SCRAPE_DISTRIBUTION=round-robin

# Optional cap on codes per run (useful for smoke tests)
# SCRAPE_LIMIT=50

# Credentials per site — pattern: SCRAPER_<KEY>_ID / _PW
SCRAPER_IBJP_ID=
SCRAPER_IBJP_PW=

# Placeholders for additional sites (up to 5 total):
# SCRAPER_SITE2_ID=
# SCRAPER_SITE2_PW=
# SCRAPER_SITE3_ID=
# SCRAPER_SITE3_PW=
# SCRAPER_SITE4_ID=
# SCRAPER_SITE4_PW=
# SCRAPER_SITE5_ID=
# SCRAPER_SITE5_PW=

# Kakao JavaScript SDK — 제약사별 일괄제출 탭에서 카카오톡 공유 기능 활성화
# https://developers.kakao.com 에서 앱 생성 후 JavaScript 키를 입력
NEXT_PUBLIC_KAKAO_APP_KEY=

# Coolsms SMS 인증 — 회원가입 휴대폰 본인인증
# https://console.coolsms.co.kr 에서 API 키 발급, 발신번호는 콘솔에서 등록 필요
COOLSMS_API_KEY=
COOLSMS_API_SECRET=
COOLSMS_SENDER=

# 카카오 알림톡 채널 — Coolsms 콘솔 > 카카오 채널 등록에서 확인
KAKAO_PF_ID=
KAKAO_TEMPLATE_FILTER_REQUEST=
KAKAO_TEMPLATE_FILTER_RESULT=

# ─── Real estate (병의원 개원 매물 모니터) ────────────────────────────────
# 네이버부동산은 약관상 자동수집을 금지합니다. 본 도구는 개인 사용 한정이며,
# 수집한 중개사 연락처를 동의 없이 광고/마케팅에 발송할 경우 정보통신망법 위반.

# 네이버 폴링 간격 (ms). 너무 짧게 두지 말 것 (3000ms 이상 권장).
RE_SCRAPE_INTERVAL_MS=3000

# 기본 수집 대상 (워치가 없을 때 사용).
# cortarNo는 네이버부동산 지도에서 행정동 클릭 시 URL에 노출되는 10자리 코드.
RE_DEFAULT_CORTARS=
RE_DEFAULT_PROPERTY_TYPES=상가,사무실,빌딩
RE_DEFAULT_TRADE_TYPES=매매,월세

# Vercel 크론이 외부 워커(Lightsail 등)에 폴링을 위임할 때 사용.
# RE_WORKER_URL=http://1.2.3.4:8080
# RE_WORKER_TOKEN=

# Vercel 크론 인증 토큰
# CRON_SECRET=

# 텔레그램 봇 토큰 (BotFather 발급) — 알림 채널로 텔레그램을 쓰면 필요
TELEGRAM_BOT_TOKEN=

# 국토부 실거래가 OpenAPI — https://www.data.go.kr 인증키 (디코딩된 값)
# 동일 인증키가 R-ONE / 소상공인 상권정보에서도 그대로 동작합니다.
MOLIT_SERVICE_KEY=

# (옵션) R-ONE / SBIZ 키를 분리 운영하고 싶을 때만 사용. 비우면 MOLIT_SERVICE_KEY 재사용.
RONE_SERVICE_KEY=
SBIZ_SERVICE_KEY=
