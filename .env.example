# ────────────────────────────────────────
# Database (Prisma + Postgres)
# ────────────────────────────────────────
DATABASE_URL="postgres://user:pass@host:6543/postgres?pgbouncer=true&connection_limit=1"

# ────────────────────────────────────────
# NextAuth
# ────────────────────────────────────────
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# ────────────────────────────────────────
# Cron 보호용 (GitHub Actions/Vercel cron 헤더에 동일 값을 Bearer 로 전달)
# ────────────────────────────────────────
CRON_SECRET="generate-a-long-random-string"

# ────────────────────────────────────────
# 시크릿 암호화 키 (AES-256-GCM)
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   미설정 시 평문 저장 (개발 OK, 운영에선 반드시 설정)
# ────────────────────────────────────────
ENCRYPTION_KEY=""

# ────────────────────────────────────────
# 텔레그램 알림
#   - 봇 토큰: @BotFather → /newbot
#   - chat_id: 개인 -> @userinfobot, 그룹 -> getUpdates
# ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ────────────────────────────────────────
# 구글시트 (Service Account JSON)
#   추후 연결. 비워두면 시트 동기화는 스킵됨.
# ────────────────────────────────────────
GOOGLE_SHEETS_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# ────────────────────────────────────────
# 네이버 커머스 API
#   사업자/스토어는 DB(NaverStore 테이블)에 등록.
#   초기 시딩용으로만 아래 값을 사용 (admin 페이지에서 추가도 가능).
# ────────────────────────────────────────
NAVER_STORE_A_CODE="A"
NAVER_STORE_A_BIZ_NAME="A사업자"
NAVER_STORE_A_STORE_NAME="A스토어"
NAVER_STORE_A_CLIENT_ID=""
NAVER_STORE_A_CLIENT_SECRET=""

NAVER_STORE_B_CODE="B"
NAVER_STORE_B_BIZ_NAME="B사업자"
NAVER_STORE_B_STORE_NAME="B스토어"
NAVER_STORE_B_CLIENT_ID=""
NAVER_STORE_B_CLIENT_SECRET=""

NAVER_STORE_C_CODE="C"
NAVER_STORE_C_BIZ_NAME="C사업자"
NAVER_STORE_C_STORE_NAME="C스토어"
NAVER_STORE_C_CLIENT_ID=""
NAVER_STORE_C_CLIENT_SECRET=""

# 보고서 타임존 (한국 고정)
REPORT_TIMEZONE="Asia/Seoul"
