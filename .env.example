# Inventory scraper configuration
# Copy to .env and fill in real values. Do NOT commit .env.

# ---- Vercel runtime (real-time stock check API) ----
# Set both on Vercel project settings, NOT here. The worker URL is the
# public address of your Lightsail server.
# WORKER_URL=http://13.124.xxx.xxx:8080
# WORKER_TOKEN=<same token as worker/.env>

# ---- Local PoC scraper (only used by scripts/win/scrape-poc.bat) ----

# Comma-separated adapter keys to run (must exist in src/scrapers/adapters/index.ts)
SCRAPER_SITES=ibjp

# Per-site rate limit between requests (ms). 2000ms = safe default.
SCRAPE_INTERVAL_MS=2000

# Distribution strategy: round-robin | cross
#   round-robin: each code hits one site (fast, load-split across sites)
#   cross:       each code hits every site (slow, enables cross-site price compare)
SCRAPE_DISTRIBUTION=round-robin

# Optional cap on codes per run (useful for smoke tests)
# SCRAPE_LIMIT=50

# Credentials per site — pattern: SCRAPER_<KEY>_ID / _PW
SCRAPER_IBJP_ID=
SCRAPER_IBJP_PW=

SCRAPER_INCHUN_ID=
SCRAPER_INCHUN_PW=

SCRAPER_FAMILY_ID=
SCRAPER_FAMILY_PW=

SCRAPER_PICOMALL_ID=
SCRAPER_PICOMALL_PW=

SCRAPER_GOY_ID=
SCRAPER_GOY_PW=
