# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/simple/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# EP bot (credentials + page dumps — never commit)
/ep-bot/ep_login.json
/ep-bot/db.json
/ep-bot/test_order.json
/ep-bot/dumps/
/ep_login.html

# 시크릿 키 포함 설정 (Supabase service_role) — never commit
/bot_config.json

# 세션 임시 산출물 (UIA 자동화 디버깅 스크립트/덤프)
/_*.ps1
/_oauth_tmp/
/*_dump.txt
/screen*.png
/stock_*.csv
/NOW()

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
