{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-worker",
    "rootDir": "src",
    "resolveJsonModule": true
  },
  "include": [
    "src/worker-server.ts",
    "src/scrapers/**/*",
    "src/lib/prisma.ts"
  ],
  "exclude": ["node_modules", "src/app", "src/components", ".next"]
}
