# Inventory worker environment template (copy to .env on the Lightsail server)

# Required: shared secret between Vercel and worker. Generate with:
#   openssl rand -hex 32
WORKER_TOKEN=

# Listen port (default 8080). Lightsail firewall must allow this port.
PORT=8080

# Per-site rate limit between requests (ms)
SCRAPE_INTERVAL_MS=1500

# Re-login if a stored browser session is older than this
SESSION_TTL_MS=1200000

# Postgres connection string (Supabase pooler recommended).
# Required for the scheduled batch — leave empty to disable scheduling.
# Example: postgresql://USER:PW@aws-0-xxx.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Cron schedule (Asia/Seoul). Default: 06:00, 12:00, 18:00 KST.
# To disable scheduler entirely set DISABLE_SCHEDULER=1
SCHEDULE_CRON=0 6,12,18 * * *
SCHEDULED_DELAY_MS=2000

# Wholesale credentials — one pair per registered adapter
SCRAPER_IBJP_ID=
SCRAPER_IBJP_PW=

SCRAPER_INCHUN_ID=
SCRAPER_INCHUN_PW=

SCRAPER_FAMILY_ID=
SCRAPER_FAMILY_PW=

# ---- ePharms 매출원장 자동수집 ----
# Vercel 쪽 EPHARMS_ENC_KEY와 반드시 동일한 값. 32바이트 hex 또는 base64.
EPHARMS_ENC_KEY=

# 매일 자정(KST) cron
EPHARMS_SCHEDULE_CRON=0 0 * * *

# 거래처 사이 대기 (ms) — ePharms 부하 분산용
EPHARMS_DELAY_MS=5000

# 1로 설정하면 ePharms 자동 sync 비활성화 (수동 트리거만)
DISABLE_EPHARMS_SCHEDULER=
