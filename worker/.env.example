# Inventory worker environment template (copy to .env on the Lightsail server)

# Required: shared secret between Vercel and worker. Generate with:
#   openssl rand -hex 32
WORKER_TOKEN=

# Listen port (default 8080). Lightsail firewall must allow this port.
PORT=8080

# Per-site rate limit between requests (ms)
SCRAPE_INTERVAL_MS=1500

# Re-login if a stored browser session is older than this
SESSION_TTL_MS=1200000

# Wholesale credentials — one pair per registered adapter
SCRAPER_IBJP_ID=
SCRAPER_IBJP_PW=

SCRAPER_INCHUN_ID=
SCRAPER_INCHUN_PW=

SCRAPER_FAMILY_ID=
SCRAPER_FAMILY_PW=

SCRAPER_PICOMALL_ID=
SCRAPER_PICOMALL_PW=

SCRAPER_GOY_ID=
SCRAPER_GOY_PW=
